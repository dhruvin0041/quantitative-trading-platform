!backend/artifacts/tft_quantile_weights.weights.h5
!backend/artifacts/frozen_strategy_manifest*.json
!backend/artifacts/v2_3/
!backend/artifacts/v3/
!backend/artifacts/research/

# Allow versioned immutable snapshot fixtures
!backend/data/snapshots/
!backend/data/snapshots/*.parquet
!backend/data/snapshots/*.json
