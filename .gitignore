!backend/data/snapshots/

# Allow specific verified production models for institutional baseline
!backend/artifacts/lgbm_agent.joblib
!backend/artifacts/xgb_ensemble.json
!backend/artifacts/latest_fusion_weights.weights.h5
!backend/artifacts/latest_scaler.joblib
!backend/artifacts/dqn_model.pth
!backend/artifacts/model_calibrator.joblib
