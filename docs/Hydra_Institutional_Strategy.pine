//@version=5
strategy("Hydra Institutional Strategy [3-Layer Architecture]", overlay=true, initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, process_orders_on_close=true)

// =============================================================================
// USER-CONFIGURABLE PARAMETERS
// =============================================================================
// Layer 1: Trend Alignment & Moving Average Settings
fast_len       = input.int(12, "Fast MA Length (Orange)", minval=1, group="1. Trend & Macro Alignment")
slow_len       = input.int(24, "Slow MA Length (Blue)", minval=1, group="1. Trend & Macro Alignment")
k_lookback     = input.int(3, "Slope Lookback k (bars)", minval=1, maxval=10, group="1. Trend & Macro Alignment", tooltip="Lookback window k for slope calculation: MA_t - MA_{t-k}")

// Layer 2: State-Machine Cooldown (Refractory Period)
cooldown_bars  = input.int(7, "Cooldown Period (Bars)", minval=3, maxval=15, group="2. State-Machine Cooldown", tooltip="Minimum bars required between consecutive executions in the same direction or post-exit")

// Layer 3: Dynamic ATR-Ratcheting Trailing Exits
atr_period     = input.int(14, "ATR Period", minval=1, group="3. Dynamic Trailing Exit")
trail_mult     = input.float(2.5, "Trailing ATR Multiplier", minval=0.5, step=0.1, group="3. Dynamic Trailing Exit", tooltip="Multiplier applied to ATR for dynamic ratcheting stop-loss")

// =============================================================================
// INDICATOR & MOMENTUM CALCULATIONS
// =============================================================================
fast_ma        = ta.ema(close, fast_len)
slow_ma        = ta.ema(close, slow_len)
atr_val        = ta.atr(atr_period)

// Slope Calculation over lookback window k: slope(MA) = MA_t - MA_{t-k}
slope_fast     = fast_ma - fast_ma[k_lookback]
slope_slow     = slow_ma - slow_ma[k_lookback]

// =============================================================================
// LAYER 1: TREND ALIGNMENT & MACRO DIRECTIONAL FILTER
// =============================================================================
// Long Entry Criteria:
// 1. fast_ma > slow_ma
// 2. slope(fast_ma) > 0 and slope(slow_ma) > 0
// 3. close > slow_ma
long_trend_aligned = (fast_ma > slow_ma) and (slope_fast > 0) and (slope_slow > 0) and (close > slow_ma)

// Short Entry Criteria:
// - Hard Prohibition: Completely suppress all SELL / Short signals while close > slow_ma
// - Valid only if close < slow_ma AND fast_ma < slow_ma AND slope(slow_ma) < 0
short_prohibited   = close > slow_ma
short_trend_aligned = (not short_prohibited) and (close < slow_ma) and (fast_ma < slow_ma) and (slope_slow < 0)

// Technical Triggers (Confirmed on Bar Close)
bullish_trigger = ta.crossover(fast_ma, slow_ma) or (low[1] <= fast_ma[1] and close > fast_ma and close > close[1]) or (low[1] <= low[2] and close > high[1])
bearish_trigger = ta.crossunder(fast_ma, slow_ma) or (high[1] >= fast_ma[1] and close < fast_ma and close < close[1]) or (high[1] >= high[2] and close < low[1])

// =============================================================================
// STATE-MACHINE PERSISTENCE & POST-EXIT REFRACTORY COOLDOWN
// =============================================================================
var int   last_long_bar   = -9999
var int   last_short_bar  = -9999
var int   last_exit_bar   = -9999
var float long_stop       = na
var float short_stop      = na

// Track closed trades to enforce identical post-stop refractory cooldown in Pine Script
if ta.change(strategy.closedtrades) > 0
    last_exit_bar := bar_index

// Post-exit refractory condition
post_exit_ok = (bar_index - last_exit_bar) >= cooldown_bars

// =============================================================================
// LAYER 3: DYNAMIC ATR-RATCHETING TRAILING EXITS (Native Bracket Orders)
// =============================================================================
// Eliminate bar-close exit distortion and execution lag using native bracket stop orders
if strategy.position_size > 0
    float candidate_long_stop = high - (trail_mult * atr_val)
    long_stop := math.max(nz(long_stop, low), candidate_long_stop)
    strategy.exit("Exit Long", "Long", stop=long_stop)
else
    long_stop := na

if strategy.position_size < 0
    float candidate_short_stop = low + (trail_mult * atr_val)
    short_stop := math.min(nz(short_stop, high), candidate_short_stop)
    strategy.exit("Exit Short", "Short", stop=short_stop)
else
    short_stop := na

// =============================================================================
// LAYER 2: STATE-MACHINE COOLDOWN & ENTRY LOGIC
// =============================================================================
// Long Entry Execution
if bullish_trigger and long_trend_aligned and (strategy.position_size <= 0) and post_exit_ok
    if (bar_index - last_long_bar) >= cooldown_bars
        last_long_bar := bar_index
        last_short_bar := -9999
        long_stop := close - (trail_mult * atr_val)
        strategy.entry("Long", strategy.long, comment="BUY")

// Short Entry Execution
if bearish_trigger and short_trend_aligned and not short_prohibited and (strategy.position_size >= 0) and post_exit_ok
    if (bar_index - last_short_bar) >= cooldown_bars
        last_short_bar := bar_index
        last_long_bar := -9999
        short_stop := close + (trail_mult * atr_val)
        strategy.entry("Short", strategy.short, comment="SELL")

// =============================================================================
// VISUALIZATION & PLOTTING
// =============================================================================
plot(fast_ma, "Fast MA (Orange)", color=color.new(#FF8C38, 0), linewidth=2)
plot(slow_ma, "Slow MA (Blue)",   color=color.new(#4FC3F7, 0), linewidth=2)

// Plot the active trailing stop line visually (discrete orange/red circles) ONLY while position is live
plot(strategy.position_size > 0 ? long_stop : strategy.position_size < 0 ? short_stop : na,
     "ATR Ratcheting Trailing Stop", color=color.new(#FF5722, 0), style=plot.style_circles, linewidth=2)

// Visual shape markers
plotshape(bullish_trigger and long_trend_aligned and post_exit_ok and (bar_index - last_long_bar[1] >= cooldown_bars) and strategy.position_size[1] <= 0,
          title="Buy Signal Marker", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small, text="BUY")

plotshape(bearish_trigger and short_trend_aligned and not short_prohibited and post_exit_ok and (bar_index - last_short_bar[1] >= cooldown_bars) and strategy.position_size[1] >= 0,
          title="Sell Signal Marker", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small, text="SELL")

plotshape(ta.change(strategy.closedtrades) > 0, title="Trailing Stop Exit Marker", style=shape.circle, location=location.abovebar, color=color.red, size=size.small, text="STOP")
